# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# YouTube Data API v3 — comma separated, used in order with failover on quota exhaustion
YOUTUBE_API_KEYS=

# Vertex AI (Gemini) — service account JSON on one line
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=
# GOOGLE_VERTEX_PROJECT_ID=
# GOOGLE_VERTEX_LOCATION=

# Shared secret between Next.js and the video-summary-worker Edge Function
VIDEO_SUMMARY_WORKER_SECRET=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_NAVER_SITE_VERIFICATION=

# Optional AI limits (defaults: 5 / 10 / 2000 per day)
# AI_DAILY_LIMIT=
# AI_IP_DAILY_LIMIT=
# AI_GLOBAL_DAILY_LIMIT=
# AI_IP_SALT=
